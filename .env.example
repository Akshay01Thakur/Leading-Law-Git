NEXT_PUBLIC_SITE_URL=https://leadinglaw.in
NEXT_PUBLIC_ADVOCATE_WHATSAPP=919999000111

# UPI payment collection (consultation fee)
NEXT_PUBLIC_UPI_VPA=yourname@yourbank
NEXT_PUBLIC_UPI_PAYEE_NAME=Leading Law
NEXT_PUBLIC_CONSULTATION_FEE=99
NEXT_PUBLIC_CONSULTATION_FEE_BEFORE=499

# Server-only. Gates /confirm so only the advocate can confirm an appointment.
# Must NOT be prefixed NEXT_PUBLIC_ or it would ship in the browser bundle.
ADVOCATE_PASSCODE=choose-a-long-random-passphrase

# Server-only. Early "new lead" WhatsApp alert to the advocate, sent when the
# customer reaches the payment step. Optional — if unset, the alert silently
# no-ops and the booking flow is unaffected. See README for CallMeBot setup.
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=
